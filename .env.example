# IAMS Backend Environment Variables
# Copy this file to .env and fill in the values.

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/iamsdb
DB_USERNAME=iams_user
DB_PASSWORD=change_me

# JWT
JWT_SECRET=change-this-to-a-32-char-or-longer-secret-key
JWT_EXPIRATION_MS=86400000

# Server
SERVER_PORT=8080
