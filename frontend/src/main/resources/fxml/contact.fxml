<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.injibara.iams.frontend.controller.InfoController"
      styleClass="view" stylesheets="@/css/app.css">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
    <Label text="Contact" styleClass="view-title"/>
    <VBox spacing="6" styleClass="card" maxWidth="700">
        <Label text="Contact Information" styleClass="section-title"/>
        <Label text="Email: haymanotebabu2@gmail.com"/>
        <Label text="Institution: Injibara University"/>
        <Label text="College: College of Engineering and Technology"/>
        <Label text="Department: Software Engineering"/>
        <Label text="Course: Advanced Programming and Software Architecture"/>
        <Label text="WhatsApp: available via the WhatsApp button in the header"/>
    </VBox>
    <VBox spacing="8" styleClass="card" maxWidth="700">
        <Label text="Send a Message" styleClass="section-title"/>
        <TextField promptText="Your Name"/>
        <TextField promptText="Your Email"/>
        <TextArea promptText="Your Message" prefRowCount="4"/>
        <Button text="Send" styleClass="primary-btn"/>
    </VBox>
    <HBox spacing="12">
        <Button text="Back to Home" onAction="#goHome"/>
        <Button text="Open WhatsApp" onAction="#goHome"/>
    </HBox>
</VBox>
