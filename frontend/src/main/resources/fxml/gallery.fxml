<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.injibara.iams.frontend.controller.InfoController"
      styleClass="view" stylesheets="@/css/app.css">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
    <Label text="Gallery" styleClass="view-title"/>
    <Label text="Sample inventory items and assets."/>
    <TilePane hgap="12" vgap="12" prefColumns="4">
        <VBox styleClass="card" prefWidth="160"><Label text="Computer" styleClass="card-title"/><Label text="Electronics" styleClass="status"/><Label text="Qty: 20" styleClass="card-value"/></VBox>
        <VBox styleClass="card" prefWidth="160"><Label text="Printer" styleClass="card-title"/><Label text="Electronics" styleClass="status"/><Label text="Qty: 5" styleClass="card-value"/></VBox>
        <VBox styleClass="card" prefWidth="160"><Label text="Chair" styleClass="card-title"/><Label text="Furniture" styleClass="status"/><Label text="Qty: 15" styleClass="card-value"/></VBox>
        <VBox styleClass="card" prefWidth="160"><Label text="Desk" styleClass="card-title"/><Label text="Furniture" styleClass="status"/><Label text="Qty: 8" styleClass="card-value"/></VBox>
        <VBox styleClass="card" prefWidth="160"><Label text="Laptop" styleClass="card-title"/><Label text="Electronics" styleClass="status"/><Label text="Qty: 12" styleClass="card-value"/></VBox>
        <VBox styleClass="card" prefWidth="160"><Label text="Projector" styleClass="card-title"/><Label text="Electronics" styleClass="status"/><Label text="Qty: 3" styleClass="card-value"/></VBox>
        <VBox styleClass="card" prefWidth="160"><Label text="Whiteboard" styleClass="card-title"/><Label text="Office" styleClass="status"/><Label text="Qty: 6" styleClass="card-value"/></VBox>
        <VBox styleClass="card" prefWidth="160"><Label text="Cabinet" styleClass="card-title"/><Label text="Furniture" styleClass="status"/><Label text="Qty: 4" styleClass="card-value"/></VBox>
    </TilePane>
    <HBox spacing="12">
        <Button text="Back to Home" onAction="#goHome"/>
        <Button text="View Inventory" onAction="#goHome" styleClass="primary-btn"/>
    </HBox>
</VBox>
