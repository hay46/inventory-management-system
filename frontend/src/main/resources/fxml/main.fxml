<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.injibara.iams.frontend.controller.MainController"
            styleClass="main-root"
            stylesheets="@/css/app.css">
    <left>
        <VBox spacing="4" styleClass="sidebar" prefWidth="220">
            <padding><Insets top="20" right="10" bottom="20" left="10"/></padding>
            <Label text="IAMS" styleClass="brand"/>
            <Label fx:id="userLabel" styleClass="user-label"/>
            <Separator/>
            <Button text="Dashboard" onAction="#showDashboard" styleClass="nav-btn"/>
            <Button text="Inventory" onAction="#showInventory" styleClass="nav-btn"/>
            <Button text="Receive Stock" onAction="#showReceive" styleClass="nav-btn"/>
            <Button text="Issue Stock" onAction="#showIssue" styleClass="nav-btn"/>
            <Button text="Low Stock" onAction="#showLowStock" styleClass="nav-btn"/>
            <Button text="Transactions" onAction="#showTransactions" styleClass="nav-btn"/>
            <Button text="Reports" onAction="#showReports" styleClass="nav-btn"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="logout-btn"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane" styleClass="content"/>
    </center>
</BorderPane>
