<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.injibara.iams.frontend.controller.IssueController"
      styleClass="view"`n      stylesheets="@/css/app.css">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Issue Stock" styleClass="view-title"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Item ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="itemIdField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Quantity:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="qtyField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Reference #:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="refField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Notes:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="notesField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <Button text="Issue" onAction="#handleIssue" styleClass="primary-btn"/>
    <Label fx:id="statusLabel" styleClass="status"/>
</VBox>

