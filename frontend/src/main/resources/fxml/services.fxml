<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.injibara.iams.frontend.controller.InfoController"
      styleClass="view" stylesheets="@/css/app.css">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
    <Label text="Services" styleClass="view-title"/>
    <Label text="IAMS provides the following services for organizations."/>
    <VBox spacing="8" styleClass="card" maxWidth="700">
        <Label text="Core Services" styleClass="section-title"/>
        <Label text="• Inventory item registration and management"/>
        <Label text="• Stock receiving and issuing transactions"/>
        <Label text="• Stock adjustment with audit history"/>
        <Label text="• Low-stock and out-of-stock alerts"/>
        <Label text="• Transaction history tracking"/>
        <Label text="• Inventory reports (CSV/PDF)"/>
        <Label text="• File import and export (CSV)"/>
    </VBox>
    <VBox spacing="8" styleClass="card" maxWidth="700">
        <Label text="Additional Services" styleClass="section-title"/>
        <Label text="• Role-based user management"/>
        <Label text="• Secure authentication (JWT)"/>
        <Label text="• Dashboard with live statistics"/>
        <Label text="• Search, filtering, and sorting"/>
        <Label text="• REST API for integration"/>
        <Label text="• Multi-user concurrent access"/>
    </VBox>
    <HBox spacing="12">
        <Button text="Back to Home" onAction="#goHome"/>
        <Button text="Sign In" onAction="#goSignIn" styleClass="primary-btn"/>
        <Button text="Contact Us" onAction="#goContact"/>
    </HBox>
</VBox>
