<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.injibara.iams.frontend.controller.InfoController"
      styleClass="view" stylesheets="@/css/app.css">
    <VBox alignment="CENTER" spacing="10" styleClass="hero" prefHeight="160">
        <padding><Insets top="20" right="40" bottom="20" left="40"/></padding>
        <Label text="🛠️" styleClass="hero-icon"/>
        <Label text="Services" styleClass="hero-title"/>
        <Label text="What IAMS offers to your organization" styleClass="hero-subtitle"/>
    </VBox>
    <VBox spacing="16" styleClass="section">
        <padding><Insets top="20" right="40" bottom="20" left="40"/></padding>
        <VBox spacing="8" styleClass="card" maxWidth="700">
            <Label text="Core Services" styleClass="section-title"/>
            <Label text="📋 Item registration and management"/>
            <Label text="📥 Stock receiving transactions"/>
            <Label text="📤 Stock issuing with validation"/>
            <Label text="🔧 Stock adjustment with audit history"/>
            <Label text="⚠️ Low-stock and out-of-stock alerts"/>
            <Label text="📜 Transaction history tracking"/>
            <Label text="📊 Inventory reports (CSV/PDF)"/>
        </VBox>
        <VBox spacing="8" styleClass="card" maxWidth="700">
            <Label text="Additional Services" styleClass="section-title"/>
            <Label text="🔐 Role-based user management"/>
            <Label text="🛡️ Secure authentication (JWT)"/>
            <Label text="📈 Dashboard with live statistics"/>
            <Label text="🔍 Search, filtering, and sorting"/>
            <Label text="🌐 REST API for integration"/>
            <Label text="👥 Multi-user concurrent access"/>
        </VBox>
        <HBox spacing="12">
            <Button text="🏠 Home" onAction="#goHome" styleClass="primary-btn"/>
            <Button text="📞 Contact" onAction="#goContact"/>
            <Button text="Sign In" onAction="#goSignIn"/>
        </HBox>
    </VBox>
</VBox>
